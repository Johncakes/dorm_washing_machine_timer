    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.95.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.6",
    "oxlint": "1.95.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
