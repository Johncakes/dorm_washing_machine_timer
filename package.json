{
  "name": "dorm-laundry",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -H localhost",
    "build": "next build",
    "start": "next start -H localhost",
    "lint": "eslint . && oxlint",
